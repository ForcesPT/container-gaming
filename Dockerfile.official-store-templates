# Generated installation-only templates must pass the account-state scrubber.
# Build these locally from the official clients; never commit a test desktop.
ARG STORE_IMAGE=dpadplay/official-stores:local
ARG TEMPLATE_IMAGE=dpadplay/gog-template:local
FROM ${TEMPLATE_IMAGE} AS templates
ARG WINDOWS_STORES=epic,gog,battlenet,ea,ubisoft
# Import installation files only. A template must never replace runtime code,
# runner patches or the launcher with files from its older build image.
RUN test -n "$WINDOWS_STORES" && mkdir /dpad-store-templates \
    && for store in $(printf '%s' "$WINDOWS_STORES" | tr ',' ' '); do \
         case "$store" in epic|gog|battlenet|ea|ubisoft) ;; *) exit 1 ;; esac; \
         cp -a "/opt/dpadcloud/$store-prefix" /dpad-store-templates/; \
       done
FROM ${STORE_IMAGE}
USER root
ARG WINDOWS_STORES=epic,gog,battlenet,ea,ubisoft
COPY scripts/dpad-sanitize-store-prefix /opt/dpadcloud/dpad-sanitize-store-prefix
COPY scripts/dpad-verify-store-templates /opt/dpadcloud/dpad-verify-store-templates
COPY --from=templates --chown=dpad:dpad /dpad-store-templates/ /opt/dpadcloud/
COPY --from=templates --chown=dpad:dpad /home/dpad/.local/share/umu/ /home/dpad/.local/share/umu/
# Apply the reviewed wrapper after installation archives so an older template
# snapshot cannot replace the current runtime/account-state routing.
COPY scripts/faugus-epic-launch scripts/dpad_faugus_prepare.py scripts/gog-launch scripts/battlenet-launch scripts/ea-launch scripts/ubisoft-launch \
    scripts/dpad_steam_proton_default.py scripts/dpad_publish_proton.py /opt/dpadcloud/
COPY scripts/steam-desktop /usr/local/bin/steam
RUN sed -i 's/\r$//' /opt/dpadcloud/dpad-sanitize-store-prefix \
    && chmod +x /opt/dpadcloud/dpad-sanitize-store-prefix \
    && sed -i 's/\r$//' /opt/dpadcloud/dpad-verify-store-templates /opt/dpadcloud/faugus-epic-launch /opt/dpadcloud/battlenet-launch /opt/dpadcloud/ea-launch /opt/dpadcloud/ubisoft-launch \
    && chmod +x /opt/dpadcloud/dpad-verify-store-templates /opt/dpadcloud/faugus-epic-launch /opt/dpadcloud/battlenet-launch /opt/dpadcloud/ea-launch /opt/dpadcloud/ubisoft-launch \
    && sed -i 's/\r$//' /opt/dpadcloud/gog-launch /usr/local/bin/steam \
    && chmod +x /opt/dpadcloud/gog-launch /usr/local/bin/steam \
    && bash -n /opt/dpadcloud/gog-launch /usr/local/bin/steam /opt/dpadcloud/faugus-epic-launch /opt/dpadcloud/battlenet-launch /opt/dpadcloud/ea-launch /opt/dpadcloud/ubisoft-launch \
    && /opt/dpadcloud/dpad-verify-store-templates --stores "$WINDOWS_STORES" \
    && test -f /home/dpad/.local/share/umu/steamrt3/.installed.ok \
    && test -x /home/dpad/.local/share/umu/steamrt3/run \
    && test -d /home/dpad/.local/share/umu/steamrt3/pressure-vessel
