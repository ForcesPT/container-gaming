#!/bin/bash
# Translate the launcher's small Sway IPC subset when Labwc is selected.
set -euo pipefail

DESKTOP="${DPAD_DESKTOP_CLIENT:-sway}"
REAL_SWAYMSG="${DPAD_REAL_SWAYMSG:-/usr/bin/swaymsg}"
WLRCTL="${DPAD_WLRCTL:-/usr/bin/wlrctl}"

if [ "$DESKTOP" = sway ]; then
    exec "$REAL_SWAYMSG" "$@"
fi
[ "$DESKTOP" = labwc ] || { echo "unsupported desktop: $DESKTOP" >&2; exit 2; }

# Launcher v0.1.3 must supply the exact marker derived from this session's
# XDG_RUNTIME_DIR. Reject missing/different transport options fail-closed.
[ -n "${XDG_RUNTIME_DIR:-}" ] || { echo "missing XDG_RUNTIME_DIR" >&2; exit 2; }
EXPECTED_MARKER="$XDG_RUNTIME_DIR/sway-ipc.labwc-compat.sock"
[ "$#" -ge 2 ] && [ "$1" = -s ] && [ "$2" = "$EXPECTED_MARKER" ] \
    || { echo "invalid Labwc swaymsg compatibility marker" >&2; exit 2; }
shift 2

if [ "$#" -eq 2 ] && [ "$1" = "-t" ] && [ "$2" = "get_tree" ]; then
    "$WLRCTL" toplevel list | python3 -c '
import json, sys
nodes=[]
for raw in sys.stdin:
    line=raw.strip()
    if not line or "DpadPlay" in line or "dpad-launcher" in line or "com.dpadplay.launcher" in line:
        continue
    title=line.split(": ", 1)[1] if ": " in line else line
    nodes.append({"type":"con", "name":title, "nodes":[], "floating_nodes":[]})
print(json.dumps({"type":"root", "name":"root", "nodes":nodes, "floating_nodes":[]}))
'
    exit 0
fi

if [ "$#" -eq 5 ] && [ "$1" = "[title=DpadPlay]" ] \
    && [ "$2" = move ] && [ "$3" = container ] && [ "$4" = to ] && [ "$5" = scratchpad ]; then
    exec "$WLRCTL" window minimize title:DpadPlay
fi
if [ "$#" -eq 2 ] && [ "$1" = scratchpad ] && [ "$2" = show ]; then
    exec "$WLRCTL" window focus title:DpadPlay
fi
if [ "$#" -eq 3 ] && [ "$1" = "[title=DpadPlay]" ] \
    && [ "$2" = fullscreen ] && [ "$3" = enable ]; then
    exec "$WLRCTL" window fullscreen title:DpadPlay
fi
echo "unsupported Labwc swaymsg compatibility command: $*" >&2
exit 2
