#!/usr/bin/env python3
"""Validate or terminate one PID-bound Waybar readiness record."""

from __future__ import annotations

import errno
import os
from pathlib import Path
import select
import signal
import sys


def fail(message: str) -> "NoReturn":
    print(f"UNHEALTHY: {message}")
    raise SystemExit(1)


def read_record(path: Path) -> tuple[str, int, int]:
    try:
        raw = path.read_bytes()
    except OSError:
        fail("Labwc Waybar taskbar has no readiness state")
    if not raw.endswith(b"\n") or raw.count(b"\n") != 1:
        fail("Labwc Waybar readiness state must contain exactly one record")
    try:
        parts = raw[:-1].decode("ascii").split()
    except UnicodeDecodeError:
        fail("Labwc Waybar readiness state is malformed")
    if len(parts) != 3:
        fail("Labwc Waybar readiness state must contain exactly one record")
    phase, pid_text, start_text = parts
    try:
        pid, start = int(pid_text), int(start_text)
    except ValueError:
        fail("Labwc Waybar readiness PID is stale")
    if phase not in {"starting", "ready"} or pid < 1 or start < 1:
        fail("invalid Labwc Waybar readiness state")
    return phase, pid, start


def snapshot(pid: int) -> tuple[str, int, str, bytes]:
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes()
    except OSError:
        fail("Labwc Waybar readiness PID is stale")
    close, open_ = stat.rfind(") "), stat.find("(")
    if open_ < 0 or close < 0:
        fail("Labwc Waybar readiness process state is malformed")
    fields = stat[close + 2 :].split()
    if len(fields) < 20:
        fail("Labwc Waybar readiness process state is malformed")
    try:
        start = int(fields[19])
    except ValueError:
        fail("Labwc Waybar readiness process state is malformed")
    return fields[0], start, stat[open_ + 1 : close], cmdline


def open_validated(path: Path, recovery: bool) -> tuple[int, int] | None:
    phase, pid, expected = read_record(path)
    try:
        pidfd = os.pidfd_open(pid)
    except OSError as exc:
        if recovery and exc.errno == errno.ESRCH:
            return None
        fail("Labwc Waybar readiness PID is stale")
    state, start, comm, cmdline = snapshot(pid)
    if start != expected:
        os.close(pidfd)
        if recovery:
            return None
        fail("Labwc Waybar readiness PID was reused")
    if state == "Z":
        os.close(pidfd)
        if recovery:
            return None
        fail("Labwc Waybar readiness PID is a zombie")
    bootstrap = state == "T" and b"dpad-waybar-child" in cmdline
    if comm != "waybar" and not (phase == "starting" and bootstrap):
        os.close(pidfd)
        fail("Labwc Waybar readiness PID is not Waybar")
    if phase == "starting":
        try:
            uptime = float(Path("/proc/uptime").read_text().split()[0])
            age = uptime - (start / os.sysconf("SC_CLK_TCK"))
        except (OSError, ValueError, IndexError):
            os.close(pidfd)
            fail("Waybar supervisor startup age is unavailable")
        if age >= 30:
            os.close(pidfd)
            fail("Waybar supervisor exceeded startup grace")
    final_state, final_start, _, _ = snapshot(pid)
    poller = select.poll()
    poller.register(pidfd, select.POLLIN)
    if final_state == "Z" or final_start != expected or poller.poll(0):
        os.close(pidfd)
        if recovery:
            return None
        fail("Labwc Waybar readiness PID exited during validation")
    return pidfd, pid


def terminate(path: Path) -> None:
    validated = open_validated(path, recovery=True)
    if validated is None:
        return
    pidfd, _ = validated
    try:
        signal.pidfd_send_signal(pidfd, signal.SIGTERM)
        poller = select.poll()
        poller.register(pidfd, select.POLLIN)
        if not poller.poll(500):
            signal.pidfd_send_signal(pidfd, signal.SIGKILL)
            poller.poll(500)
    finally:
        os.close(pidfd)


def main() -> None:
    terminate_mode = len(sys.argv) == 3 and sys.argv[1] == "--terminate"
    if not terminate_mode and len(sys.argv) != 2:
        fail("Waybar state validator requires one state file")
    path = Path(sys.argv[-1])
    if terminate_mode:
        terminate(path)
    else:
        validated = open_validated(path, recovery=False)
        assert validated is not None
        os.close(validated[0])


if __name__ == "__main__":
    main()
