#!/bin/bash
# launcher-shell — start the authoritative DpadPlay Electron store launcher in
# the nested Sway cloud-gaming desktop.
#
# Gamepad: the launcher polls SDL3 via koffi (the Web Gamepad API doesn't see
# the mknod'd /dev/input/jsN pads in-container). It needs the classic-joystick
# interposer + the SDL3 env the entrypoint's session already exports
# (SDL_JOYSTICK_LINUX_CLASSIC=1, SDL_JOYSTICK_DISABLE_UDEV=1,
# SDL_JOYSTICK_DEVICE=/dev/input/js0, SDL_GAMECONTROLLERCONFIG, LD_PRELOAD=
# selkies_joystick_interposer.so). When run as the sway startup app those are
# inherited; for a manual `docker exec` test they must be set on the process.
#
# Usage:  launcher-shell   (env: DISPLAY / XDG_RUNTIME_DIR / SDL_* / LD_PRELOAD
#         must be exported by the caller — the entrypoint's launch line does.)
# Logs:   /tmp/launcher.log
set -e

APPDIR="/opt/dpadcloud/launcher"
APPRUN="${APPDIR}/dpad-launcher"

# Prepare inventory before any store GUI can cache its installed-game list.
# Login, Wine setup and Play remain the customer's normal in-session store flow.
if [ -n "${DPAD_INSTANT_APP:-}${DPAD_INSTANT_METADATA:-}" ]; then
    if [ "${DPAD_EPIC_BACKEND:-heroic}" = faugus ]; then
        if [ "${DPAD_FAUGUS_INSTANT_TEST:-}" = 1 ] && [ -n "${DPAD_EPIC_INSTALLATION_SHA256:-}" ]; then
            # Clone/install the official client before adding game records.
            # Otherwise registration makes an empty prefix non-empty and the
            # wrapper must preserve it instead of cloning its installed template.
            timeout --kill-after=15s 330s "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/faugus-epic-launch" --prepare-only >>/tmp/instant-registration.log 2>&1 || exit 1
            timeout 15s python3 -I "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/dpad_epic_installation.py" register >>/tmp/instant-registration.log 2>&1 || exit 1
            # Instant Play has already selected the store and game. Open only
            # the official client with this release's launch request.
            exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/faugus-epic-launch" --instant >>/tmp/launcher.log 2>&1
        elif [ "${DPAD_FAUGUS_CLIENT_ONLY_TEST:-}" != 1 ]; then
            echo 'launcher-shell: official Epic Instant import is not qualified; use a Cloud Compute candidate session' >&2
            exit 1
        else
            echo 'launcher-shell: Faugus client-only canary; shared game import is not registered' >&2
        fi
    else
        if ! timeout 15s python3 -I "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/dpad_instant_register.py" >>/tmp/instant-registration.log 2>&1; then
            echo "launcher-shell: Instant registration refused" >&2
            exit 1
        fi
    fi
fi

# Electron sandbox off (the container has userns; --no-sandbox avoids the
# setuid chrome-sandbox requirement, matching the other Electron clients).
[ -x "${APPRUN}" ] || { echo 'launcher-shell: store picker unavailable' >&2; exit 1; }
exec "${APPRUN}" --no-sandbox >/tmp/launcher.log 2>&1
