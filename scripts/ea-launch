#!/bin/bash
# ea-launch — launch the EA App (EADesktop.exe) Windows client under
# GE-Proton11-3 via umu-launcher (the Steam Linux Runtime container) in the
# headless cloud-gaming session. The dpad-launcher's "EA App" store card
# (launcher/src/main.js) spawns this; it runs IN THE SAME sway/XWayland
# session (inheriting DISPLAY=:0, the NVIDIA EGL vendor, PULSE_SERVER, the
# gamepad interposer env) so the EA App window is captured by the
# wayland-display compositor + the user interacts via Selkies.
#
# This follows the battlenet-launch pattern exactly:
#   1. Wine prefix at ~/Games/ea-app (-> <vol>/games/ea-app on a persistent
#      volume; the capped rootfs on ephemeral sessions).
#   2. GE-Proton11-3 (already baked in compatibilitytools.d/) — bundles the
#      NVIDIA compat libs + umu.exe. EA App is a CEF/Electron app → same
#      Xwayland path as Battle.net (PROTON_ENABLE_WAYLAND unset).
#   3. First launch: umu-run winetricks initializes the prefix (corefonts/
#      win10/vcrun2022/d3dcompiler_47) inside the SLR, then downloads +
#      runs EAappInstaller.exe. Every later launch reuses the installed
#      launcher + the stored login token.
#   4. CEF software compositing: --disable-gpu --in-process-gpu (same fix as
#      Battle.net — the CEF GPU present path white-screens under
#      Xwayland-in-SLR).
#
# Container nesting: same as battlenet-launch — umu uses pressure-vessel →
# bwrap, which needs --cap-add SYS_ADMIN + --security-opt seccomp=unconfined
# apparmor=unconfined systempaths=unconfined (IMAGE-RUNBOOK).
#
# Env inherited from the launcher (the entrypoint's shared_env via launcher-shell):
#   DISPLAY=:0  WAYLAND_DISPLAY  XDG_RUNTIME_DIR  PULSE_SERVER  HOME  USER
# Logs: /tmp/ea-launch.log (+ UMU_LOG=1 / PROTON_LOG=1 for verbose).
set -u

LOG=/tmp/ea-launch.log
echo "[ea-launch] $(date -Is) start (HOME=${HOME:-} DISPLAY=${DISPLAY:-})" >> "$LOG"

# --- umu-run / GE-Proton / prefix paths --------------------------------------
# The Wine prefix. ~/Games/ea-app (-> <vol>/games/ea-app on a persistent
# volume; the capped rootfs on ephemeral). An explicit WINEPREFIX override is
# respected (manual tests / probes).
PREFIX="${WINEPREFIX:-${HOME}/Games/ea-app}"
mkdir -p "$PREFIX" 2>/dev/null || true
export WINEPREFIX="$PREFIX"

# GE-Proton11-3 — same as battlenet-launch. Bundles the NVIDIA compat libs
# (NVAPI/CUDA/NVENC/NVML) + umu.exe. EA App runs via Xwayland
# (PROTON_ENABLE_WAYLAND unset) per STORES-PLAN §5.
GP_DIR="${HOME}/.steam/debian-installation/compatibilitytools.d/GE-Proton11-3"
if [ ! -x "$GP_DIR/proton" ]; then
    echo "[ea-launch] FATAL: GE-Proton11-3 not found at $GP_DIR (no proton binary)" | tee -a "$LOG" >&2
    exit 1
fi
export PROTONPATH="$GP_DIR"

# umu-run env: STORE=eaapp + GAMEID (umu-eaapp is the conventional id for the
# EA App launcher — applies any eaapp-store protonfix if present, else
# umu-default = no fix, which is fine: the win is the SLR container's tested
# wow64, not a gamefix).
export STORE="${STORE:-eaapp}"
export GAMEID="${GAMEID:-umu-eaapp}"
export PROTON_VERB="${PROTON_VERB:-waitforexitandrun}"

# Locate umu-run (the deb installs /usr/bin/umu-run; allow a PATH override).
UMU_RUN="${UMU_RUN:-umu-run}"
if ! command -v "$UMU_RUN" >/dev/null 2>&1; then
    echo "[ea-launch] FATAL: umu-run not found on PATH (install the umu-launcher deb)" | tee -a "$LOG" >&2
    exit 1
fi
echo "[ea-launch] umu-run=$(command -v "$UMU_RUN") prefix=$PREFIX proton=$GP_DIR store=$STORE gameid=$GAMEID" >> "$LOG"

# 2026 EA-App-on-GE-Proton must-haves. WINE_SIMULATE_WRITECOPY fixes the CEF
# write-copy mapping that blanks the installer/login UI (same as Battle.net).
# locationapi=d disables the Windows Location API DLL that can stall init.
export WINE_SIMULATE_WRITECOPY=1
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-locationapi=d}"
# Quieter Proton/wine spam in the log. Flip to PROTON_LOG=1 for verbose.
export WINEDEBUG="${WINEDEBUG:--all}"

# Defensive: drop the session's gamepad-interposer LD_PRELOAD before entering
# the SLR container (same rationale as battlenet-launch).
unset LD_PRELOAD

# EA App paths. The installer produces "EALauncher.exe" (the main launcher
# exe); some installs name it "EADesktop.exe". We install-detect + launch
# whichever is present. EA installs to "Program Files\Electronic Arts\EA
# Desktop\EA Desktop\".
EA_DIR="$PREFIX/drive_c/Program Files/Electronic Arts/EA Desktop/EA Desktop"
EA_INST="$EA_DIR/EALauncher.exe"
EA_INST_ALT="$EA_DIR/EADesktop.exe"
EA_EXE='C:\Program Files\Electronic Arts\EA Desktop\EA Desktop\EALauncher.exe'
EA_EXE_ALT='C:\Program Files\Electronic Arts\EA Desktop\EA Desktop\EADesktop.exe'

# The canonical installer URL (confirmed via NonSteamLaunchers + EA forums).
# EA hosts the installer on Akamai's CDN. A browser User-Agent avoids CDN
# edge cases.
SETUP_URL='https://origin-a.akamaihd.net/EA-Desktop-Client-Download/installer-releases/EAappInstaller.exe'
UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36'
SETUP_DIR="$PREFIX/drive_c/ea-setup"
SETUP_EXE="$SETUP_DIR/EAappInstaller.exe"

# installed = either launcher exe present
ea_installed() { [ -f "$EA_INST" ] || [ -f "$EA_INST_ALT" ]; }

# --- prebaked prefix check (mirrors battlenet-launch) -------------------------
# If a build-time prebaked prefix is baked in the image (build-bootstrap-ea.sh
# → /opt/dpadcloud/ea-prefix with a .dpad-prebaked marker: the winetricks-
# initialized prefix + the downloaded EAappInstaller.exe + the Steam Linux
# Runtime already downloaded to ~/.local/share/umu), copy it to the session
# WINEPREFIX. This skips the ~2-min winetricks + ~657 MB SLR download + the
# installer download on every first launch — only the EA App installer runs
# (which needs the user to click through it in the stream), or if the silent
# install succeeded at build time, goes straight to login.
PREBAKED_SRC="/opt/dpadcloud/ea-prefix"
if [ ! -f "$PREFIX/.dpad-prebaked" ] && [ -f "$PREBAKED_SRC/.dpad-prebaked" ]; then
    echo "[ea-launch] first launch — copying the prebaked prefix $PREBAKED_SRC -> $PREFIX (skips winetricks + SLR download + installer download; ~seconds)" | tee -a "$LOG" >&2
    mkdir -p "$PREFIX" 2>/dev/null || true
    if cp -a "$PREBAKED_SRC/." "$PREFIX/" 2>>"$LOG"; then
        chown -R "${USER:-dpad}:${USER:-dpad}" "$PREFIX" 2>/dev/null || true
        echo "[ea-launch] prebaked prefix copied (winetricks + installer present)" >> "$LOG"
    else
        echo "[ea-launch] prebaked prefix copy failed — falling back to the full winetricks" >> "$LOG"
    fi
fi

# --- first-launch install (one-time per prefix) -------------------------------
if ! ea_installed; then
    # If the prefix isn't prebaked (no marker), run the full winetricks + download.
    if [ ! -f "$PREFIX/.dpad-prebaked" ]; then
        echo "[ea-launch] first launch — initializing the Wine prefix under umu/SLR, then downloading + installing EA App (the installer window will appear in the stream; ~5-10 min, one-time)" | tee -a "$LOG" >&2

        # Pre-config the prefix BEFORE the installer (mirrors the Lutris EA App
        # install script). Running winetricks through umu-run creates the prefix
        # inside the Steam Linux Runtime container (Proton's wine + Valve's tested
        # 32/64-bit libs) + applies the verbs in one step.
        echo "[ea-launch] umu-run winetricks -q corefonts win10 vcrun2022 d3dcompiler_47" >> "$LOG"
        "$UMU_RUN" winetricks -q corefonts win10 vcrun2022 d3dcompiler_47 >>"$LOG" 2>&1 \
            || echo "[ea-launch] umu-run winetricks exited $? (best-effort — the SLR's matched libs are the real fix)" >> "$LOG"

        mkdir -p "$SETUP_DIR" 2>/dev/null || true
        if ! curl -fsSL -A "$UA" -o "$SETUP_EXE" "$SETUP_URL" >>"$LOG" 2>&1; then
            echo "[ea-launch] FATAL: EAappInstaller.exe download failed ($SETUP_URL)" | tee -a "$LOG" >&2
            exit 1
        fi
        echo "[ea-launch] downloaded $(ls -l "$SETUP_EXE" 2>/dev/null | awk '{print $5}') bytes — running installer under umu/SLR" >> "$LOG"
    else
        echo "[ea-launch] prebaked prefix present — skipping winetricks + installer download; running the installer" >> "$LOG"
    fi

    # Run the EA App installer through umu-run (GE-Proton inside the SLR).
    # The installer is a Chromium/CEF GUI: it opens a window on DISPLAY (:0,
    # sway's Xwayland), downloads the EA App client, + installs it. Best-
    # effort: a failed/half install leaves the prefix for inspection;
    # re-launch retries.
    "$UMU_RUN" "$SETUP_EXE" >>"$LOG" 2>&1 || echo "[ea-launch] installer exited $?" >> "$LOG"

    # Wait (up to 15 min) for the install to produce the launcher.
    i=0
    while [ $i -lt 90 ] && ! ea_installed; do
        sleep 10; i=$((i+1))
    done
    rm -rf "$SETUP_DIR" 2>/dev/null || true
else
    echo "[ea-launch] EA App already installed in the prebaked prefix — skipping the installer; launching directly" >> "$LOG"
fi

if ! ea_installed; then
    echo "[ea-launch] FATAL: EA App launcher not found after install ($EA_INST / $EA_INST_ALT)" | tee -a "$LOG" >&2
    exit 1
fi

# Pick the launch exe: prefer EALauncher.exe; fall back to EADesktop.exe.
if [ -f "$EA_INST" ]; then EXE="$EA_EXE"; else EXE="$EA_EXE_ALT"; fi
# EA App is a Chromium/CEF app. Under Wine/Proton + Xwayland the CEF GPU
# present path white-screens (same issue as Battle.net). Force CEF software
# compositing with --disable-gpu + --in-process-gpu. Env-overridable via
# DPAD_EA_CEF_ARGS (e.g. '' to disable, or PROTON_ENABLE_WAYLAND=1 + the
# GE-Proton11-2 wine-wayland fix path instead).
EA_CEF_ARGS="${DPAD_EA_CEF_ARGS:---disable-gpu --in-process-gpu}"
echo "[ea-launch] launching $EXE under umu/SLR (cef_args=$EA_CEF_ARGS)" >> "$LOG"
exec "$UMU_RUN" "$EXE" $EA_CEF_ARGS