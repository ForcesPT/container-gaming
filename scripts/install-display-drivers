#!/bin/bash
# install-display-drivers — ported from vast-ai/base-image (ROOT/opt/instance-tools/bin/).
#
# Installs NVIDIA display-driver *userspace* libraries (OpenGL / GLX / EGL
# / Vulkan, 32- and 64-bit) matching the host's driver version.
#
# Why DpadCloud needs this: some Vast hosts install only the *compute* portion of
# the NVIDIA driver, so the nvidia-container-toolkit injects libcuda (CUDA compute
# works) but omits the graphics/render userspace libs. VirtualGL (VGL_DISPLAY=egl)
# and Selkies then fail with "libGL.so.1 / libEGL.so.1 cannot open shared object"
# — and there's no way to know before renting. This downloads the exact matching
# NVIDIA .run, extracts the libraries to /opt/nvidia-drivers, and registers them
# with ldconfig (at a *lower* priority than the toolkit libs, so toolkit-mounted
# libs win for callers without the explicit compositor library-path override).
#
# NOTE: raw extraction may contain compute/video files, but only the explicit
# graphics projection is registered or selected. libnvidia-encode is supplied by the
# container toolkit via the `video`/`all` driver capability. NVENC's multi-GPU
# peer-init bug (#1249) is handled separately by the flexgrip interposer.
#
# Idempotent: cached libraries are revalidated and private metadata is published
# on every run (re-extracts if the host driver version changed or DDX is missing).
# Requirements: root, internet, an NVIDIA GPU. Downloads ~300 MB on first run.

set -euo pipefail
umask 022

# Required on old images too: never continue with a missing helper.
/opt/dpadcloud/dpad-nvidia-egl prepare

NVIDIA_DRIVERS_DIR="/opt/nvidia-drivers"
# Lower priority than container toolkit libs (zz-* sorts after the toolkit confs)
NVIDIA_DRIVERS_LDCONF="/etc/ld.so.conf.d/zz-nvidia-drivers.conf"

# Both cold extraction and old warm caches use the same graphics-only projection.
# -n creates package SONAME links without registering the raw cache. Replace the
# old broad ldconfig file on every run, then rebuild the actual system cache.
publish_display_libraries() {
    ldconfig -n "${NVIDIA_DRIVERS_DIR}/lib64" "${NVIDIA_DRIVERS_DIR}/lib32"
    /opt/dpadcloud/dpad-nvidia-egl publish
    {
        echo "${NVIDIA_DRIVERS_DIR}/graphics/lib64"
        echo "${NVIDIA_DRIVERS_DIR}/graphics/lib32"
    } > "$NVIDIA_DRIVERS_LDCONF"
    ldconfig
    /opt/dpadcloud/dpad-nvidia-egl check
}

configure_nvidia_display_drivers() {
    command -v nvidia-smi &>/dev/null || { echo "ERROR: no nvidia-smi / GPU"; return 1; }

    # Read driver version from kernel module
    local DRIVER_VERSION
    DRIVER_VERSION="$(head -n1 </proc/driver/nvidia/version | awk '{ for(i=1;i<=NF;i++) if($i ~ /^[0-9]+\.[0-9]+(\.[0-9]+)?$/) { print $i; exit } }')"
    if [[ -z "$DRIVER_VERSION" ]]; then
        echo "Warning: Could not determine NVIDIA driver version from /proc"
        return 1
    fi

    # If we already extracted libs for this exact driver version, ensure
    # ldconfig paths are registered and return early.
    if [[ -f "${NVIDIA_DRIVERS_DIR}/.driver-version" ]]; then
        local CACHED_VERSION
        CACHED_VERSION="$(<"${NVIDIA_DRIVERS_DIR}/.driver-version")"
        if [[ "$CACHED_VERSION" == "$DRIVER_VERSION" ]] && [[ -f /usr/lib/xorg/modules/nvidia/drivers/nvidia_drv.so ]]; then
            publish_display_libraries
            echo "NVIDIA display driver ${DRIVER_VERSION} libs already installed"
            return 0
        fi
        echo "Driver version changed (${CACHED_VERSION} -> ${DRIVER_VERSION}) or X DDX missing, clearing stale libs"
        rm -rf "${NVIDIA_DRIVERS_DIR}"
        rm -f "${NVIDIA_DRIVERS_LDCONF}"
        ldconfig
    fi

    # Always extract both 64-bit and 32-bit driver libraries from the .run
    # package.  The nvidia-container-toolkit injects some 64-bit libs from
    # the host but often omits 32-bit libs, Vulkan presentation components,
    # and on newer GPUs (e.g. Blackwell) may provide incomplete libraries
    # that cause crashes.
    echo "Installing NVIDIA display driver ${DRIVER_VERSION} libs (64-bit + 32-bit)..."

    # Download the .run package
    local DRIVER_ARCH="x86_64"
    local RUN_FILE="NVIDIA-Linux-${DRIVER_ARCH}-${DRIVER_VERSION}.run"
    local TMPDIR
    TMPDIR="$(mktemp -d /tmp/nvidia-driver-XXXXXX)"

    local DOWNLOAD_OK=false
    for BASE_URL in \
        "https://international.download.nvidia.com/XFree86/Linux-${DRIVER_ARCH}/${DRIVER_VERSION}" \
        "https://international.download.nvidia.com/tesla/${DRIVER_VERSION}"; do
        echo "Downloading ${BASE_URL}/${RUN_FILE} ..."
        if curl -fL --connect-timeout 15 --max-time 300 --retry 2 --progress-bar -o "${TMPDIR}/${RUN_FILE}" "${BASE_URL}/${RUN_FILE}"; then
            DOWNLOAD_OK=true
            break
        fi
    done

    if ! $DOWNLOAD_OK; then
        echo "Warning: Failed to download NVIDIA driver ${DRIVER_VERSION} .run package"
        rm -rf "$TMPDIR"
        return 1
    fi

    # Extract without running nvidia-installer
    local EXTRACT_DIR="${TMPDIR}/extracted"
    if ! sh "${TMPDIR}/${RUN_FILE}" --extract-only --target "$EXTRACT_DIR" 2>/dev/null; then
        echo "Warning: Failed to extract NVIDIA driver .run package"
        rm -rf "$TMPDIR"
        return 1
    fi

    # Copy libraries and Vulkan manifests
    mkdir -p "${NVIDIA_DRIVERS_DIR}/lib64" "${NVIDIA_DRIVERS_DIR}/lib32"

    # 64-bit libs are in the extraction root
    if [[ -d "$EXTRACT_DIR" ]]; then
        cp -a "$EXTRACT_DIR"/*.so* "${NVIDIA_DRIVERS_DIR}/lib64/" 2>/dev/null
        for json in nvidia_icd.json nvidia_layers.json; do
            if [[ -f "$EXTRACT_DIR/$json" ]]; then
                cp -a "$EXTRACT_DIR/$json" "${NVIDIA_DRIVERS_DIR}/lib64/"
            fi
        done
        echo "Installed 64-bit NVIDIA display/Vulkan driver libs"
    fi

    # X server nvidia DDX driver + GLX module (for a REAL Xorg with the nvidia
    # driver — gives Vulkan a present surface so DXVK/Proton can render). These
    # ship in the SAME .run we already extracted, so there's no extra download.
    # They go under /usr/lib/xorg/modules/nvidia (a private ModulePath listed
    # first by our xorg.conf) so the mesa libglx.so that Xvfb relies on in the
    # default ModulePath is NOT shadowed.
    if [[ -f "$EXTRACT_DIR/nvidia_drv.so" ]]; then
        mkdir -p /usr/lib/xorg/modules/nvidia/drivers \
                 /usr/lib/xorg/modules/nvidia/extensions
        cp -a "$EXTRACT_DIR/nvidia_drv.so" /usr/lib/xorg/modules/nvidia/drivers/
        local _glx
        for _glx in "$EXTRACT_DIR"/libglx.so.*; do
            [[ -e "$_glx" ]] && cp -a "$_glx" /usr/lib/xorg/modules/nvidia/extensions/
        done
        # Xorg dlopens the unversioned libglx.so — point it at the nvidia build.
        local _glxv
        _glxv=$(ls /usr/lib/xorg/modules/nvidia/extensions/libglx.so.* 2>/dev/null | head -1) || true
        [[ -n "$_glxv" ]] && ln -sf "$(basename "$_glxv")" \
            /usr/lib/xorg/modules/nvidia/extensions/libglx.so
        echo "Installed nvidia_drv.so + libglx (X DDX) under /usr/lib/xorg/modules/nvidia"
    fi
    if [[ -f "$EXTRACT_DIR/nvidia-xconfig" ]]; then
        cp -a "$EXTRACT_DIR/nvidia-xconfig" /usr/bin/nvidia-xconfig
        chmod +x /usr/bin/nvidia-xconfig
        echo "Installed nvidia-xconfig"
    fi

    # 32-bit libs are in the 32/ subdirectory
    if [[ -d "${EXTRACT_DIR}/32" ]]; then
        cp -a "${EXTRACT_DIR}/32"/*.so* "${NVIDIA_DRIVERS_DIR}/lib32/" 2>/dev/null
        echo "Installed 32-bit NVIDIA display driver libs"
    fi

    # EGL and headless Vulkan metadata are published privately below. Never
    # copy over toolkit-mounted /usr/share/glvnd or /etc/vulkan files.

    # Record version for cache validation on next run
    echo "$DRIVER_VERSION" > "${NVIDIA_DRIVERS_DIR}/.driver-version"

    # Clean up temp files
    rm -rf "$TMPDIR"

    publish_display_libraries

    echo "NVIDIA display driver ${DRIVER_VERSION} libs configured. You may need to"
    echo "restart any process that needs them (e.g. the relevant supervisor service)."
}

configure_nvidia_display_drivers