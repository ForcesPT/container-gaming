#!/bin/bash
# dpad-open-url — called by xdg-open/winebrowser when a Windows app (EA App,
# Battle.net, Ubisoft Connect) tries to open an external URL (OAuth login,
# store page, etc.). Opens the URL in a simple fullscreen Electron window
# inside the same sway/XWayland session so the user can interact with it
# via the Selkies stream — no external browser needed.
#
# The dpad-launcher's Electron binary is reused (it's already installed at
# /opt/dpadcloud/launcher/dpad-launcher). We launch a second instance with
# ELECTRON_OVERRIDE_URL to load the OAuth page instead of the launcher UI.
#
# Installed as /usr/local/bin/xdg-open (replacing the system xdg-open) so
# winebrowser → xdg-open → this script.
LOG=/tmp/dpad-open-url.log
echo "[$(date -Is)] dpad-open-url: args=$*" >> "$LOG"

URL=""
for arg in "$@"; do
    case "$arg" in
        http://*|https://*) URL="$arg"; break ;;
    esac
done

if [ -z "$URL" ]; then
    echo "[dpad-open-url] no URL found in args: $*" | tee -a "$LOG" >&2
    exit 0
fi

echo "[dpad-open-url] opening $URL" | tee -a "$LOG"

# Use the dpad-launcher Electron binary to open the URL in a simple window.
# --kiosk makes it fullscreen (matches the store launcher UX). The launcher
# binary already has the Electron runtime + all native deps (libgtk, libnss,
# etc.) linked. We pass the URL directly as the first arg to load.
ELECTRON=/opt/dpadcloud/launcher/dpad-launcher

if [ ! -x "$ELECTRON" ]; then
    echo "[dpad-open-url] FATAL: dpad-launcher binary not found at $ELECTRON" | tee -a "$LOG" >&2
    # Fallback: print the URL so the user can open it manually
    echo "OPEN IN YOUR BROWSER: $URL" | tee -a "$LOG" >&2
    exit 0
fi

# Launch Electron in kiosk mode loading the URL. Detached so xdg-open
# returns immediately (Wine doesn't wait for the browser to close).
DISPLAY="${DISPLAY:-:0}" \
HOME="${HOME:-/home/dpad}" \
USER="${USER:-dpad}" \
XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1001}" \
nohup "$ELECTRON" --kiosk --no-sandbox "$URL" >>"$LOG" 2>&1 &

echo "[dpad-open-url] launched Electron kiosk for $URL (pid $!)" >> "$LOG"
exit 0