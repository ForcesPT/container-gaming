#!/usr/bin/python3
"""Validate generated account-free store templates before an image can be built."""
import argparse
from pathlib import Path
import re
import subprocess

EXECUTABLES = {
    'epic': ['drive_c/Program Files/Epic Games/Launcher/Portal/Binaries/Win64/EpicGamesLauncher.exe'],
    'gog': ['drive_c/Program Files/GOG Galaxy/GalaxyClient.exe'],
    'battlenet': ['drive_c/Program Files (x86)/Battle.net/Battle.net Launcher.exe',
                  'drive_c/Program Files (x86)/Battle.net/Battle.net.exe'],
    'ea': ['drive_c/Program Files/Electronic Arts/EA Desktop/EA Desktop/EADesktop.exe',
           'drive_c/Program Files/Electronic Arts/EA Desktop/*/EA Desktop/EADesktop.exe'],
    'ubisoft': ['drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/UbisoftConnect.exe',
               'drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher/upc.exe'],
}
parser = argparse.ArgumentParser()
parser.add_argument('--stores', default=','.join(EXECUTABLES))
parser.add_argument('--root', default='/opt/dpadcloud')
args = parser.parse_args()
stores = args.stores.split(',')
if not stores or len(set(stores)) != len(stores) or set(stores) - EXECUTABLES.keys():
    parser.error('Expected a unique list of known official stores')
helpers = Path(__file__).resolve().parent
for store in stores:
    runtime = 'steamrt3' if store in ('epic', 'gog') else 'steamrt4'
    runtime_path = Path('/home/dpad/.local/share/umu') / runtime
    if not (runtime_path / '.installed.ok').is_file() or not (runtime_path / 'run').is_file():
        raise SystemExit(f'{store}: validated shared runtime is missing')
    prefix = Path(args.root) / f'{store}-prefix'
    marker = prefix / '.dpad-preinstalled'
    if prefix.is_symlink() or marker.is_symlink() or not marker.is_file():
        raise SystemExit(f'{store}: finalized installation template missing')
    subprocess.run([str(helpers / 'dpad-sanitize-store-prefix'), str(prefix)], check=True)
    subprocess.run([str(helpers / 'dpad-randomize-prefix-id'), '--template', str(prefix)], check=True)
    candidates = [path for pattern in EXECUTABLES[store] for path in prefix.glob(pattern)]
    if not any(subprocess.run([str(helpers / 'dpad-verify-windows-binary'), '--pe-only', str(path)],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
               for path in candidates):
        raise SystemExit(f'{store}: official client executable is missing')
    registry = (prefix / 'system.reg').read_text()
    if re.findall(r'"MachineGuid"="([^"]+)"', registry) != ['00000000-0000-0000-0000-000000000000']:
        raise SystemExit(f'{store}: template identity is not neutral')
    print(f'OFFICIAL_STORE_TEMPLATE_READY store={store}')
