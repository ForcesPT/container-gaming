#!/bin/bash
# launcher-toggle — toggle the dpad-launcher visibility (bound to Super+L in
# the sway config). If the launcher is in the scratchpad, show it. If it's
# visible, do nothing (it's already on screen). If the launcher process is
# dead (crashed), relaunch it via launcher-shell.
#
# This is the recovery path: if the user loses the launcher (crash, accidental
# kill), Super+L brings it back.
set -euo pipefail

LOG=/tmp/launcher-toggle.log
echo "$(date -Is) launcher-toggle invoked" >> "$LOG"

# Check if the launcher process is running
if ! pgrep -x dpad-launcher >/dev/null 2>&1; then
  echo "$(date -Is) launcher process not found — relaunching" >> "$LOG"
  exec /opt/dpadcloud/launcher-shell
fi

# Launcher is running — use the selected compositor's native control path.
case "${DPAD_DESKTOP_CLIENT:-sway}" in
labwc)
  WLRCTL="${DPAD_WLRCTL:-/usr/bin/wlrctl}"
  MATCH=""
  if "$WLRCTL" window focus title:DpadPlay 2>>"$LOG"; then
    MATCH=title:DpadPlay
  elif "$WLRCTL" window focus app_id:com.dpadplay.launcher 2>>"$LOG"; then
    MATCH=app_id:com.dpadplay.launcher
  else
    echo "$(date -Is) Labwc could not focus launcher" >> "$LOG"
    exit 1
  fi
  if ! "$WLRCTL" window fullscreen "$MATCH" 2>>"$LOG"; then
    echo "$(date -Is) Labwc focused launcher but could not restore fullscreen" >> "$LOG"
    exit 1
  fi
  echo "$(date -Is) launcher focused via Labwc foreign-toplevel protocol" >> "$LOG"
  exit 0
  ;;
sway) ;;
*) echo "$(date -Is) unsupported desktop ${DPAD_DESKTOP_CLIENT}" >> "$LOG"; exit 2 ;;
esac

# Sway: show the launcher from scratchpad.
# Find the sway socket
SOCK=""
if [ -n "${SWAYSOCK:-}" ]; then
  SOCK="$SWAYSOCK"
else
  RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  for candidate in "${RUNTIME_DIR}"/sway-ipc.*.sock; do
    [ -S "$candidate" ] || continue
    SOCK="$candidate"
    break
  done
fi

if [ -z "$SOCK" ]; then
  echo "$(date -Is) no sway socket found — cannot toggle" >> "$LOG"
  exit 1
fi

# Show from scratchpad + fullscreen
swaymsg -s "$SOCK" 'scratchpad show' 2>>"$LOG" || true
sleep 0.2
swaymsg -s "$SOCK" '[title="DpadPlay"] fullscreen enable' 2>>"$LOG" || true
echo "$(date -Is) launcher shown from scratchpad" >> "$LOG"