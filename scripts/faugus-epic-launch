#!/bin/bash
# Candidate official Epic route. All mutable client state is private to the user.
set -euo pipefail
umask 077
export FAUGUS_DISABLE_UPDATES=1
export UMU_RUNTIME_UPDATE=0
export PROTONPATH=/home/dpad/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34
export PROTON_ENABLE_WAYLAND=0
# The authenticated Epic client repeatedly lost its graphics device under
# WineD3D. Its DXVK/Vulkan path remained signed in on the Paris L4 canary.
unset PROTON_USE_WINED3D
export VK_ICD_FILENAMES="${VK_ICD_FILENAMES:-/etc/vulkan/icd.d/nvidia_icd.json}"
export WINEPREFIX="${HOME}/Faugus/epic-games"
export GAMEID=umu-default
unset XDG_DATA_HOME XDG_CONFIG_HOME XDG_STATE_HOME
if [ -z "${DPAD_FAUGUS_STATE_ROOT:-}" ] && [ -n "${DPAD_VOLUME_MOUNT:-}" ]; then
    test -d "$DPAD_VOLUME_MOUNT" || { echo 'Faugus volume is unavailable' >&2; exit 1; }
    export DPAD_FAUGUS_STATE_ROOT="${DPAD_VOLUME_MOUNT}/faugus"
fi
if [ -n "${DPAD_FAUGUS_STATE_ROOT:-}" ]; then
    export WINEPREFIX="${DPAD_FAUGUS_STATE_ROOT}/prefixes/epic-games"
    export XDG_CONFIG_HOME="${DPAD_FAUGUS_STATE_ROOT}/config"
    export XDG_DATA_HOME="${DPAD_FAUGUS_STATE_ROOT}/data"
    export XDG_STATE_HOME="${DPAD_FAUGUS_STATE_ROOT}/state"
fi
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
python3 -I "${script_dir}/dpad_faugus_prepare.py" --lock-only
exec 9<"${XDG_STATE_HOME:-${HOME}/.local/state}/faugus-launcher/dpad-epic.lock"
flock -n 9 || { echo 'Epic is already starting or running' >&2; exit 1; }
python3 -I "${script_dir}/dpad_faugus_prepare.py"
epic_exe="${WINEPREFIX}/drive_c/Program Files/Epic Games/Launcher/Portal/Binaries/Win64/EpicGamesLauncher.exe"
if [ ! -f "$epic_exe" ]; then
    installer=/opt/dpadcloud/faugus/EpicGamesLauncherInstaller.msi
    echo 'd55d79710edfeaa107a62f2ea007bec1eeeac8b715a43c2ba3858eec7bc60337  /opt/dpadcloud/faugus/EpicGamesLauncherInstaller.msi' | sha256sum -c -
    # Show the official installer; the account owner completes its normal flow.
    faugus-launcher --run "/usr/bin/umu-run msiexec /i ${installer}"
    test -f "$epic_exe" || { echo 'Epic installation is not completed; reopen Epic to retry' >&2; exit 1; }
fi
launch_started_ns="$(date +%s%N)"
launch_started_s="$(date +%s)"
faugus_args=(--game dpad-epic)
if [ "${DPAD_EPIC_DIAGNOSTICS:-0}" = 1 ]; then
    # Admin canary only: keep UMU/Proton logs in the private Faugus data root
    # and capture Wine errors. warn+seh emits millions of repeated null-fault
    # lines when Epic enters its restart loop and can exhaust the VM disk.
    export WINEDEBUG="${WINEDEBUG:--all,err+all}"
    faugus_args+=(--logs)
fi
set +e
faugus-launcher "${faugus_args[@]}"
launch_status=$?
set -e

# Epic's new self-updater runs as a Windows service. In the GPU canary it
# returned StartServiceFailed and Faugus exited before showing a login window.
# Retry only that exact fresh failure. The guarded Faugus process handoff can
# keep the wrapper alive for at least 20 seconds after Epic's updater exits,
# so a 30-second limit can miss the failure observed on the GPU canary.
# Normal user exits do not have a fresh StartServiceFailed log.
if [ "$(( $(date +%s) - launch_started_s ))" -lt 120 ]; then
    sleep 2
fi
if [ "$(( $(date +%s) - launch_started_s ))" -lt 120 ] \
   && python3 -I "${script_dir}/dpad_epic_updater_failed.py" "$WINEPREFIX" "$launch_started_ns"; then
    echo 'Epic updater service did not start; retrying the launcher once' >&2
    sleep 8
    retry_started_ns="$(date +%s%N)"
    set +e
    faugus-launcher "${faugus_args[@]}"
    retry_status=$?
    set -e
    if python3 -I "${script_dir}/dpad_epic_updater_failed.py" "$WINEPREFIX" "$retry_started_ns"; then
        echo 'Epic updater service failed again; inspect EpicGamesUpdater logs' >&2
        exit 1
    fi
    exit "$retry_status"
fi
exit "$launch_status"
