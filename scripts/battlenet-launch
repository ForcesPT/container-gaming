#!/bin/bash
# battlenet-launch — launch the Battle.net Windows client under GE-Proton11-3
# via umu-launcher (the Steam Linux Runtime container) in the headless
# cloud-gaming session. The dpad-launcher's "Battle.net" store card
# (launcher/src/main.js) spawns this; it runs IN THE SAME sway/XWayland
# session (inheriting DISPLAY=:0, the NVIDIA EGL vendor, PULSE_SERVER, the
# gamepad interposer env) so the Battle.net window is captured by the
# wayland-display compositor + the user interacts via Selkies.
#
# Why umu-launcher (not raw wine): the 2026-08-10 live test (PROJECT_STATE §18)
# got the Blizzard installer + the 32-bit Blizzard Update Agent (Agent.exe,
# PE32 Intel 80386) to download fully under raw GE-Proton wine, but the Agent
# would NOT launch ("BLZBNTBTS0000005C / BLZBNTAGT00000002, Failed to
# communicate with Agent after launch, Agent.exe error=2"). Agent.exe is
# 32-bit + Wine 11's "experimental new wow64 mode" struggles with its process
# creation/IPC — the documented-fragile manual-wine wall. umu-run wraps
# GE-Proton in Valve's Steam Linux Runtime container (matched 32+64-bit libs +
# Valve's tested wow64 + protonfixes) — the 2026 consensus reliable path
# (sudowheel: "Method 1: Via Steam [umu] is the most reliable approach"; the
# manual-wine path is the fragile one). The image already runs Steam/Proton,
# so pressure-vessel works in the container. STORES-PLAN §10 piece 1c.
#
# Container nesting: umu uses pressure-vessel → bwrap, which needs
# unshare(CLONE_NEWUSER) + a few syscalls. Our session container already runs
# with the bwrap-nest flag set (IMAGE-RUNBOOK): --cap-add SYS_ADMIN +
# --security-opt seccomp=unconfined + --security-opt apparmor=unconfined, +
# the host sysctls kernel.unprivileged_userns_clone=1 +
# kernel.apparmor_restrict_unprivileged_userns=0 (vm-bootstrap.sh). If
# pressure-vessel hits "Can't mount proc on /newroot/proc", add
# --security-opt systempaths=unconfined to the docker run (the fourth bwrap-
# nest flag) — a runtime-validation item, not a wrapper concern.
#
# First launch: umu-run winetricks initializes the prefix (corefonts/win10/
# vcrun2022/d3dcompiler_47) inside the SLR, then downloads + runs the Blizzard
# installer (Battle.net-Setup.exe) — the installer window appears in the
# stream + the user clicks through any EULA; it downloads + installs
# Battle.net.exe. Every later launch reuses the installed launcher + the
# stored login token.
#
# The prefix lives at ~/Games/battlenet (symlinked to <vol>/games/battlenet by
# the entrypoint's setup_stores when a persistent volume is attached), so the
# Battle.net login token + installed games persist across End+relaunch.
# Ephemeral sessions (no volume) install onto the (capped, 200 GB) rootfs.
#
# The ~1–2 GB Steam Linux Runtime + pressure-vessel download to
# $HOME/.local/share/umu on the FIRST umu-run (one-time per VM, first-run
# latency; the VM has network). Subsequent launches reuse it.
#
# Env inherited from the launcher (the entrypoint's shared_env via launcher-shell):
#   DISPLAY=:0  WAYLAND_DISPLAY  XDG_RUNTIME_DIR  PULSE_SERVER  HOME  USER
# We set WINEPREFIX + PROTONPATH + STORE + GAMEID ourselves. Logs:
# /tmp/battlenet-launch.log (+ UMU_LOG=1 / PROTON_LOG=1 for verbose).
set -u

LOG=/tmp/battlenet-launch.log
echo "[battlenet-launch] $(date -Is) start (HOME=${HOME:-} DISPLAY=${DISPLAY:-})" >> "$LOG"

# --- umu-run / GE-Proton / prefix paths --------------------------------------
# The Wine prefix. ~/Games/battlenet (-> <vol>/games/battlenet on a persistent
# volume; the capped rootfs on ephemeral). An explicit WINEPREFIX override is
# respected (manual tests / probes).
PREFIX="${WINEPREFIX:-${HOME}/Games/battlenet}"
mkdir -p "$PREFIX" 2>/dev/null || true
export WINEPREFIX="$PREFIX"

# GE-Proton11-3 — the Battle.net white-screen fix is in (GE-Proton11-2
# changelog: "Battle.net: fixed Wine Wayland white-screen behavior" +
# "--in-process-gpu handling for Wine Wayland launchers") + it bundles the
# NVIDIA compat libs (NVAPI/CUDA/NVENC/NVML) + umu.exe. All Windows launchers
# run via Xwayland (PROTON_ENABLE_WAYLAND unset) per STORES-PLAN §5.
GP_DIR="${HOME}/.steam/debian-installation/compatibilitytools.d/GE-Proton11-3"
if [ ! -x "$GP_DIR/proton" ]; then
    echo "[battlenet-launch] FATAL: GE-Proton11-3 not found at $GP_DIR (no proton binary)" | tee -a "$LOG" >&2
    exit 1
fi
export PROTONPATH="$GP_DIR"

# umu-run env: STORE=battlenet (umu-database store id) + GAMEID (overridable;
# umu-battlenet is the conventional id for the launcher — applies any
# battlenet-store protonfix if present, else umu-default = no fix, which is
# fine: the win is the SLR container's tested wow64, not a gamefix).
export STORE="${STORE:-battlenet}"
export GAMEID="${GAMEID:-umu-battlenet}"
export PROTON_VERB="${PROTON_VERB:-waitforexitandrun}"

# Locate umu-run (the deb installs /usr/bin/umu-run; allow a PATH override for
# manual tests / a user-install at $HOME/.local/bin).
UMU_RUN="${UMU_RUN:-umu-run}"
if ! command -v "$UMU_RUN" >/dev/null 2>&1; then
    echo "[battlenet-launch] FATAL: umu-run not found on PATH (install the umu-launcher deb)" | tee -a "$LOG" >&2
    exit 1
fi
echo "[battlenet-launch] umu-run=$(command -v "$UMU_RUN") prefix=$PREFIX proton=$GP_DIR store=$STORE gameid=$GAMEID" >> "$LOG"

# 2026 Battle.net-on-GE-Proton must-haves (NixOS Wiki, WineHQ AppDB,
# GamingOnLinux Feb 2026). WINE_SIMULATE_WRITECOPY fixes the CEF write-copy
# mapping that blanks the installer/login UI (Proton's wine honors it).
# locationapi=d disables the Windows Location API DLL that stalls the Blizzard
# Update Agent init → the "BLZBNTBNA00000005" agent-sleep / install-stall class.
export WINE_SIMULATE_WRITECOPY=1
export WINEDLLOVERRIDES="locationapi=d"
# Quieter Proton/wine spam in the log (the install is chatty otherwise). Flip
# to PROTON_LOG=1 for a verbose steam-<gameid>.log in $HOME when debugging.
export WINEDEBUG="${WINEDEBUG:--all}"

# Defensive: drop the session's gamepad-interposer LD_PRELOAD before entering
# the SLR container — the interposer is a host-side hack for Steam/SDL pad
# discovery; it has no business inside pressure-vessel (the .so path won't
# resolve in the SLR's library stack, + a dangling LD_PRELOAD can warn/fail
# bwrap). Wine games read /dev/input/jsN via their own input stack inside the
# container. umu 1.4.1+ also unsets LD_PRELOAD in gamescope sessions; this
# makes it explicit regardless of the umu version.
unset LD_PRELOAD

# Battle.net paths. Windows paths inside the prefix are backslash-quoted.
# The Lutris install script (battlenet-standard) produces "Battle.net Launcher.exe"
# (the main launcher); "Battle.net.exe" (no space) is also present + some setups
# prefer it (lutris/docs: "It simply won't start -> change executable from
# Battle.net Launcher.exe to Battle.net.exe"). We install-detect + launch the
# Launcher, falling back to Battle.net.exe.
BN_DIR="$PREFIX/drive_c/Program Files (x86)/Battle.net"
BN_INST="$BN_DIR/Battle.net Launcher.exe"
BN_INST_ALT="$BN_DIR/Battle.net.exe"
BN_EXE='C:\Program Files (x86)\Battle.net\Battle.net Launcher.exe'
BN_EXE_ALT='C:\Program Files (x86)\Battle.net\Battle.net.exe'
# The canonical installer URL (Lutris battlenet-standard + the 2026 Ubuntu blog).
# NOTE: the older getInstaller?installer=Battle.net-Setup.exe endpoint 400s from
# the OVH/EU IP; getInstallerForGame?os=win&version=LIVE&gameProgram=BATTLENET_APP
# is the working one. A browser User-Agent avoids CDN edge cases.
SETUP_URL='https://www.battle.net/download/getInstallerForGame?os=win&version=LIVE&gameProgram=BATTLENET_APP'
UA='Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36'
SETUP_DIR="$PREFIX/drive_c/battlenet-setup"
SETUP_EXE="$SETUP_DIR/Battle.net-Setup.exe"

# installed = either launcher exe present
bn_installed() { [ -f "$BN_INST" ] || [ -f "$BN_INST_ALT" ]; }

# --- first-launch install (one-time per prefix) -------------------------------
if ! bn_installed; then
    echo "[battlenet-launch] first launch — initializing the Wine prefix under umu/SLR, then downloading + installing Battle.net (the installer window will appear in the stream; ~5-10 min, one-time)" | tee -a "$LOG" >&2

    # Pre-config the prefix BEFORE the installer (mirrors the Lutris battlenet-
    # standard script). Running winetricks through umu-run creates the prefix
    # inside the Steam Linux Runtime container (Proton's wine + Valve's tested
    # 32/64-bit libs) + applies the verbs in one step — the clean replacement
    # for the old `wineboot --init` + system-`winetricks` pair.
    #   corefonts       — the installer's CEF UI needs MS fonts
    #   win10           — Battle.net's server comms + SSL/DNS handling require
    #                     Win10 (the sudowheel 2026 guide's networking fix)
    #   vcrun2022       — the Blizzard Update Agent (Agent.exe) needs the VC++
    #                     2022 runtime
    #   d3dcompiler_47  — the D3D compiler (without it Agent.exe fails to
    #                     launch with error=2 → the installer
    #                     BLZBNTBTS0000005C / BLZBNTAGT00000002 stall)
    # Best-effort: a winetricks failure leaves the prefix for the installer to
    # complete (fonts/verbs are polish; the SLR's matched libs are the real fix).
    echo "[battlenet-launch] umu-run winetricks -q corefonts win10 vcrun2022 d3dcompiler_47" >> "$LOG"
    "$UMU_RUN" winetricks -q corefonts win10 vcrun2022 d3dcompiler_47 >>"$LOG" 2>&1 \
        || echo "[battlenet-launch] umu-run winetricks exited $? (best-effort — the SLR's matched libs are the real fix)" >> "$LOG"

    # Pre-write the Battle.net config: disable HardwareAcceleration + Sound +
    # Streaming (the launcher is Chromium/CEF — HW accel in a headless/XWayland
    # prefix misrenders; sound/streaming are unused server-side). This is the
    # linchpin Lutris step for headless/Proton installs. A plain file write —
    # no wine needed (the installer/Battle.net reads it on first launch).
    bn_user="${USER:-dpad}"
    bn_cfg_dir="$PREFIX/drive_c/users/$bn_user/AppData/Roaming/Battle.net"
    mkdir -p "$bn_cfg_dir" 2>/dev/null || true
    cat > "$bn_cfg_dir/Battle.net.config" <<'BNCFG'
{"Client":{"GameLaunchWindowBehavior":"2","GameSearch":{"BackgroundSearch":"true"},"HardwareAcceleration":"false","Install":{"DownloadLimitNextPatchInBps":"0"},"Sound":{"Enabled":"false"},"Streaming":{"StreamingEnabled":"false"}},"Games":{"s2":{"AdditionalLaunchArguments":"-Displaymode 1"}}}
BNCFG
    chown -R "${USER:-dpad}:${USER:-dpad}" "$bn_cfg_dir" 2>/dev/null || true
    echo "[battlenet-launch] wrote $bn_cfg_dir/Battle.net.config (HW accel/sound/streaming off)" >> "$LOG"

    mkdir -p "$SETUP_DIR" 2>/dev/null || true
    if ! curl -fsSL -A "$UA" -o "$SETUP_EXE" "$SETUP_URL" >>"$LOG" 2>&1; then
        echo "[battlenet-launch] FATAL: Battle.net-Setup download failed ($SETUP_URL)" | tee -a "$LOG" >&2
        exit 1
    fi
    echo "[battlenet-launch] downloaded $(ls -l "$SETUP_EXE" 2>/dev/null | awk '{print $5}') bytes — running installer under umu/SLR" >> "$LOG"

    # Run the Blizzard installer through umu-run (GE-Proton inside the SLR).
    # The 32-bit Agent.exe now launches under Valve's tested wow64 → fixes the
    # "Failed to communicate with Agent" stall. The installer is a Chromium
    # GUI: it opens a window on DISPLAY (:0, sway's Xwayland), downloads the
    # Battle.net client, + installs it. The setup stub may hand off to a
    # downloader + exit, or block until done — either way we then poll for the
    # launcher to appear. Best-effort: a failed/half install leaves the prefix
    # for inspection; re-launch retries.
    "$UMU_RUN" "$SETUP_EXE" >>"$LOG" 2>&1 || echo "[battlenet-launch] installer exited $?" >> "$LOG"

    # Wait (up to 15 min) for the install to produce the launcher.
    i=0
    while [ $i -lt 90 ] && ! bn_installed; do
        sleep 10; i=$((i+1))
    done
    rm -rf "$SETUP_DIR" 2>/dev/null || true
fi

if ! bn_installed; then
    echo "[battlenet-launch] FATAL: Battle.net launcher not found after install ($BN_INST / $BN_INST_ALT)" | tee -a "$LOG" >&2
    exit 1
fi

# Pick the launch exe: prefer Battle.net Launcher.exe (Lutris standard); fall
# back to Battle.net.exe (no space) if only that is present.
if [ -f "$BN_INST" ]; then EXE="$BN_EXE"; else EXE="$BN_EXE_ALT"; fi
# Battle.net is a Chromium/CEF app. Under Wine/Proton + Xwayland the CEF GPU
# present path white-screens (the window shows content only on hover-damage —
# render works, the surface isn't continuously presented; the SLR's
# libnvidia-egl-wayland also can't find libwayland-server.so.0). Force CEF
# software compositing with --disable-gpu + --in-process-gpu (the launcher UI
# is light; installed GAMES spawn separately under their own Proton, unaffected).
# Env-overridable via DPAD_BATTLENET_CEF_ARGS (e.g. '' to disable, or
# PROTON_ENABLE_WAYLAND=1 + the GE-Proton11-2 wine-wayland fix path instead).
BN_CEF_ARGS="${DPAD_BATTLENET_CEF_ARGS:---disable-gpu --in-process-gpu}"
# Battle.net is single-instance: if the installer auto-launched it, this exec
# just focuses the existing window + the second process exits; otherwise it
# starts the launcher fresh. Either way the user lands on the Battle.net login.
echo "[battlenet-launch] launching $EXE under umu/SLR (cef_args=$BN_CEF_ARGS)" >> "$LOG"
exec "$UMU_RUN" "$EXE" $BN_CEF_ARGS