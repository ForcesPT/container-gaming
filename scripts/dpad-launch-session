#!/usr/bin/env bash
# =============================================================================
# DpadCloud v2 — per-session container launcher (warm-VM model)
# =============================================================================
# Runs ON the warm-pool VM host (SSH'd by the dpadplay worker on session start).
# The v2 warm pool is a BOOTED VM (Docker ready, image pulled, MPS daemon up) —
# NOT pre-launched containers (you can't bind-mount a volume into a running
# container). This script launches a FRESH per-session container with the user's
# persistent library volume mounted, waits for the DPAD_READY marker, and
# returns. On session end, dpad-stop-session (below) stops+removes the container;
# the VM stays warm for the next session.
#
# The volume: the dpadplay control plane (UpCloud adapter) hotplug-attaches the
# user's block-storage storage to this running VM (virtio), then SSHes this
# script. UpCloud presents a RAW UNFORMATTED block device (/dev/vdX); this script
# mkfs's it on first attach (label dpadvol-<uuid8>), then mounts it by label
# (blkid -L — device-letter-agnostic). Data persists across detach/reattach
# (validated live). See container-gaming/entrypoint.sh setup_user_volume() for
# the in-container library-subpath symlinks.
#
# Usage (from the worker over SSH):
#   dpad-launch-session launch <slot> <volumeId> <device> <selkiesPassword> [image]
#     slotIndex      0-based slot on the VM (coturn port = 3478 + slotIndex;
#                   container name = dpad-slot-<slotIndex>)
#     volumeId       the provider storage UUID (used for the fs label + mount dir),
#                   OR the literal `none` for an EPHEMERAL / no-library session:
#                   no provider volume; the container rootfs is capped at 200 GB
#                   via `--storage-opt size` (default, DPAD_EPHEMERAL_DISK_GB
#                   overrides). REQUIRES the VM's Docker backing fs to support
#                   project quotas — vm-bootstrap sets up /var/lib/docker on an
#                   XFS-prjquota loopback (on the VM's own boot disk). Games live
#                   in the capped container overlay, gone on container removal
#                   (re-download each launch). See the ephemeral branch in launch().
#     device         the provider device address returned by attach, e.g. virtio:1
#                   (mapped to /dev/vd<letter>; virtio:0=vda is the OS disk).
#                   IGNORED when volumeId == none.
#     selkiesPassword  the per-session Selkies browser password
#     image          optional image tag (default: forcespt/dpadcloud-gaming:dpad-SteamOS)
#
#   dpad-launch-session stop <slot>   tear down a session container (session end /
#                                     idle-reap). For a persistent slot the control
#                                     plane hotplug-detaches the volume after this
#                                     returns; for an ephemeral slot the container
#                                     removal frees the overlay (nothing to detach).
#
# Env (read from /etc/environment or the SSH env):
#   DPAD_SLOT_CPUS, DPAD_SLOT_MEM_MB   per-slot CPU/RAM quota (oversubscription)
#   DPAD_SELKIES_BIND                 Selkies bind (0.0.0.0 for direct-IP v2)
#   DPAD_GAMESCOPE                    1 (the SteamOS path)
#   DPAD_EPHEMERAL_DISK_GB            (optional) hard cap on an ephemeral slot's
#                                    container rootfs via `--storage-opt size=`.
#                                    Only applied when the backing Docker storage
#                                    driver supports per-container quotas (XFS
#                                    with pquota, or ext4 mounted with prjquota).
#                                    Default unset = no cap (the VM's instance disk
#                                    is shared across the N slots; one ephemeral
#                                    user could fill it — the 10-min idle
#                                    teardown bounds the risk). Only set it once the
#                                    VM is known to support it (a vm-bootstrap ops
#                                    decision); if set + the driver rejects it,
#                                    docker run fails.
# =============================================================================
set -uo pipefail

TURN_BASE_PORT=3478
SELKIES_BASE_PORT=16100
IMAGE_DEFAULT="forcespt/dpadcloud-gaming:dpad-SteamOS"
MOUNT_ROOT="/mnt/dpad-vol"
LABEL_PREFIX="dpadvol"
CONTAINER_PREFIX="dpad-slot"

log() { echo "[dpad-launch] $*" >&2; }
err() { echo "[dpad-launch] ERROR: $*" >&2; }

# Map an UpCloud virtio device address (virtio:N) -> /dev/vd<letter> (virtio:0=vda).
# UpCloud attaches the OS disk first (vda); user volumes attach as vdb, vdc, ...
# in attach order, so the mapping is deterministic.
dev_for_address() {
    local addr="$1"
    case "$addr" in
        virtio:*) printf '/dev/vd%s' "$(awk -F: '{printf "%c", 97+$2}' <<<"$addr")" ;;
        /dev/*)   printf '%s' "$addr" ;;   # already a path (future providers)
        *)        return 1 ;;
    esac
}

# Find or format+mount the volume for a storage UUID. Returns the host mount path
# on stdout (for the docker -v bind). Idempotent: if already mounted (a re-launch
# after a container died), reuse it.
# Is /dev/<x> a candidate for a freshly-attached (raw, unlabelled) user volume?
# Exclude: loop/cdrom/floppy/ram, the docker XFS loopback, any MOUNTED device, any
# device already labelled dpadvol-* (another user's attached volume on an
# oversubscribed VM), and the BOOT disk (which has partitions vda1/vda2 — a raw
# user volume is unpartitioned).
is_raw_volume_dev() {
    local d="$1" base="${1#/dev/}"
    case "$base" in loop*|sr*|fd*|ram*|zram*) return 1 ;; esac
    [ -b "$d" ] || return 1
    findmnt -rn -S "$d" >/dev/null 2>&1 && return 1
    local lbl; lbl="$(blkid -o export "$d" 2>/dev/null | awk -F= '/^LABEL=/{print $2}')"
    case "$lbl" in dpadvol-*) return 1 ;; esac
    # boot disk has partitions (vda1/vda2); a raw user volume does not.
    lsblk -nl -o NAME "$d" 2>/dev/null | grep -qE "^${base}p?[0-9]+$" && return 1
    return 0
}

# Find the raw user-volume device by exclusion (the only unpartitioned,
# unmounted, unlabelled, non-loop disk). Returns /dev/<x> on stdout.
find_raw_volume_dev() {
    local d
    for d in $(lsblk -nd -o NAME 2>/dev/null); do
        case "$d" in loop*|sr*|fd*|ram*|zram*) continue ;; esac
        is_raw_volume_dev "/dev/$d" && { echo "/dev/$d"; return 0; }
    done
    return 1
}

mount_volume() {
    local volumeId="$1" device="$2"
    local uuid8="${volumeId%%-*}"            # first 8 hex chars of the UUID
    local label="${LABEL_PREFIX}-${uuid8}"
    local mnt="${MOUNT_ROOT}/${volumeId}"

    # Already mounted (re-launch after a container crash)? Reuse.
    if findmnt -rn -T "$mnt" >/dev/null 2>&1; then
        echo "$mnt"; return 0
    fi

    # Re-attach of an already-formatted volume: mount by LABEL — device-letter
    # agnostic. The guest may re-attach the same volume at a different
    # /dev/vd<letter> after a detach (the virtio slot isn't reused), so don't
    # rely on the address->letter hint here.
    local found
    found="$(blkid -L "$label" 2>/dev/null || true)"
    if [ -n "$found" ] && [ -b "$found" ]; then
        log "volume already formatted ($label on $found) — mounting by label"
        mkdir -p "$mnt"
        mount -L "$label" "$mnt" || { err "mount by label failed"; return 1; }
        chown -R 1001:1001 "$mnt" 2>/dev/null || true
        echo "$mnt"; return 0
    fi

    # First attach (raw, unformatted): find the block device. The provider passes
    # a virtio:N address (-> /dev/vd<letter>) as a HINT, but the letter is
    # UNRELIABLE after a detach — the guest doesn't reuse a freed vd<letter>, so
    # the next attach skips ahead (observed live: a volume attached as vdc while
    # the adapter reported virtio:1=vdb, after the prior session's vdb was
    # detached). So: prefer the hint if it is a raw volume; else find the raw
    # volume by exclusion (not the boot disk / docker loop / mounted /
    # dpadvol-labelled device). Poll up to 30s for the async hotplug to surface
    # the device.
    local hint dev
    hint="$(dev_for_address "$device" 2>/dev/null || true)"
    dev=""
    local _tries=0
    while [ -z "$dev" ]; do
        if [ -n "$hint" ] && [ -b "$hint" ] && is_raw_volume_dev "$hint"; then
            dev="$hint"
        else
            dev="$(find_raw_volume_dev)"
        fi
        if [ -n "$dev" ]; then break; fi
        _tries=$((_tries+1))
        if [ $_tries -ge 30 ]; then
            err "volume device did not appear after ${_tries}s (attach not complete? hint=$hint). Block devices present:"
            lsblk -nd -o NAME,SIZE,MOUNTPOINT 2>/dev/null | sed 's/^/    /' >&2
            return 1
        fi
        sleep 1
    done

    # Sanity: refuse to clobber a foreign filesystem.
    if [ -n "$(blkid "$dev" 2>/dev/null)" ]; then
        err "$dev is formatted but not labelled $label (got: $(blkid -o export "$dev" 2>/dev/null | grep LABEL)); refusing to mkfs"
        return 1
    fi
    log "first attach — mkfs.ext4 -L $label $dev"
    mkfs.ext4 -q -F -L "$label" "$dev" || { err "mkfs failed on $dev"; return 1; }

    mkdir -p "$mnt"
    mount -L "$label" "$mnt" || { err "mount failed"; return 1; }
    # The container runs Steam as uid 1001 (dpad) — make the volume writable.
    chown -R 1001:1001 "$mnt" 2>/dev/null || true
    echo "$mnt"
}

# Detect the ephemeral sentinel. The worker passes volumeId == 'none' (or '-')
# for a no-library session; device is ignored in that case. Case-insensitive.
is_ephemeral() {
    case "${1:-}" in
        none|NONE|None|-) return 0 ;;
        *) return 1 ;;
    esac
}

launch() {
    local slot="$1" volumeId="$2" device="$3" pass="$4" image="${5:-$IMAGE_DEFAULT}"
    local name="${CONTAINER_PREFIX}-${slot}"
    local port=$(( TURN_BASE_PORT + slot ))
    local selkies_port=$(( SELKIES_BASE_PORT + slot ))

    # Stop+remove a stale container at this slot (a re-launch after a crash).
    if docker ps -a --format '{{.Names}}' | grep -qx "$name"; then
        log "removing stale container $name"
        docker rm -f "$name" >/dev/null
    fi

    # Per-slot resource quota (oversubscription). Defaults: no quota if unset
    # (the VM plan's CPU/RAM is shared; set DPAD_SLOT_CPUS/DPAD_SLOT_MEM_MB to
    # hard-partition). Mirrors vm-bootstrap's compute_session_resources.
    local -a res=()
    [ "${DPAD_SLOT_CPUS:-0}" -gt 0 ] 2>/dev/null && res+=( --cpus="${DPAD_SLOT_CPUS}" )
    [ "${DPAD_SLOT_MEM_MB:-0}" -gt 0 ] 2>/dev/null && res+=( --memory="${DPAD_SLOT_MEM_MB}m" --memory-swap="${DPAD_SLOT_MEM_MB}m" )

    # Volume bind (persistent) vs ephemeral. A persistent slot mounts the user's
    # provider block storage at /mnt/dpad-library (DPAD_VOLUME_MOUNT → the
    # entrypoint's setup_user_volume symlinks the library subpaths there). An
    # ephemeral slot caps the CONTAINER ROOTFS at 200 GB via `--storage-opt size`
    # (no volume bind): Steam's storage UI shows ~200 GB and a user can't write
    # past it. Games live in the capped container overlay, gone on container
    # removal (re-download each launch). REQUIRES the VM's Docker backing fs to
    # support project quotas — vm-bootstrap's ensure_docker_xfs_quota sets up
    # /var/lib/docker on an XFS-prjquota loopback (on the VM's own boot disk) so
    # this enforces on every provider, incl. ephemeral-disk ones (MassedCompute).
    local -a vol_args=()
    if is_ephemeral "$volumeId"; then
        log "ephemeral slot $slot — capped container rootfs (games re-download each launch, gone on end)"
        # Per-container rootfs cap via --storage-opt size (default 200 GB;
        # DPAD_EPHEMERAL_DISK_GB overrides, in GB). On a plain ext4 root this is
        # silently accepted but NOT enforced — the VM MUST have run
        # vm-bootstrap's ensure_docker_xfs_quota (XFS prjquota), else the cap
        # won't apply. vm-bootstrap verifies enforcement at bootstrap time, so
        # reaching here means it's safe.
        local cap_gb="${DPAD_EPHEMERAL_DISK_GB:-200}"
        vol_args+=( --storage-opt "size=${cap_gb}g" )
        log "  ephemeral rootfs cap: ${cap_gb} GB (--storage-opt size=${cap_gb}g)"
    else
        local mnt
        mnt="$(mount_volume "$volumeId" "$device")" || return 1
        log "volume mounted at $mnt -> /mnt/dpad-library in container"
        vol_args+=( -v "${mnt}:/mnt/dpad-library" -e DPAD_VOLUME_MOUNT=/mnt/dpad-library )
    fi

    # Bind-mount the host's fetched entrypoint.sh over the image's baked one
    # (vm-bootstrap fetches it to /opt/dpadcloud/entrypoint.sh). Lets entrypoint
    # hotfixes go live WITHOUT an image rebuild + Docker Hub push. Falls back to
    # the image's baked entrypoint if the host file isn't present.
    local entry_mount=()
    [ -f /opt/dpadcloud/entrypoint.sh ] \
        && entry_mount+=( -v /opt/dpadcloud/entrypoint.sh:/opt/dpadcloud/entrypoint.sh:ro )

    docker run -d --name "$name" \
        --runtime=nvidia -e NVIDIA_VISIBLE_DEVICES=nvidia.com/gpu=0 \
        --cap-add SYS_ADMIN --security-opt seccomp=unconfined --security-opt apparmor=unconfined \
        --shm-size=2g --ulimit nofile=1048576:1048576 \
        "${res[@]}" \
        "${vol_args[@]}" \
        "${entry_mount[@]}" \
        -p "${port}:${port}/udp" \
        -p "${selkies_port}:16100" \
        -v "/tmp/nvidia-mps:/tmp/nvidia-mps" \
        -e CUDA_MPS_PIPE_DIRECTORY=/tmp/nvidia-mps \
        -e DPAD_GAMESCOPE=1 \
        -e DPAD_TUNNEL=ssh \
        -e DPAD_SLOT="$slot" \
        -e DPAD_COTURN_PORT="$port" \
        -e DPAD_SELKIES_BIND="${DPAD_SELKIES_BIND:-0.0.0.0}" \
        -e DPAD_TURN_PUBLIC_IP="${PUBLIC_IPADDR:-}" \
        -e DPAD_TURN_UDP_EXTERNAL_PORT="$port" \
        -e SELKIES_BASIC_AUTH_USER=dpad \
        -e "SELKIES_BASIC_AUTH_PASSWORD=${pass}" \
        "$image" || { err "docker run $name failed"; return 1; }
    log "container $name launched (coturn ${port}/udp, selkies ${selkies_port}->16100, login dpad/${pass:0:4}…)"

    # Wait for the DPAD_READY marker (entrypoint emits it once Selkies is up).
    local deadline=$(( $(date +%s) + 360 ))   # 6 min (container boot ~50s + Steam)
    while [ "$(date +%s)" -lt "$deadline" ]; do
        if docker logs "$name" 2>&1 | grep -q '^DPAD_READY '; then
            log "READY: $(docker logs "$name" 2>&1 | grep '^DPAD_READY ' | tail -1)"
            return 0
        fi
        # Container died before ready?
        if ! docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null | grep -q true; then
            err "container $name exited before DPAD_READY — last logs:"
            docker logs --tail 20 "$name" 2>&1 | sed 's/^/      /' >&2
            return 1
        fi
        sleep 4
    done
    err "timed out waiting for DPAD_READY — last logs:"
    docker logs --tail 30 "$name" 2>&1 | sed 's/^/      /' >&2
    return 1
}

# -----------------------------------------------------------------------------
# dpad-stop-session — tear down a session container (called on session end /
# idle-reap). Detaches the volume mount? NO — leave it mounted (a quick re-launch
# reuses it); the dpadplay control plane hotplug-DETACHES the volume via the
# adapter after this returns. The VM stays warm.
# -----------------------------------------------------------------------------
stop() {
    local slot="$1"
    local name="${CONTAINER_PREFIX}-${slot}"
    if docker ps -a --format '{{.Names}}' | grep -qx "$name"; then
        log "stopping+removing $name"
        docker rm -f "$name" >/dev/null 2>&1 || true
    else
        log "no container $name to stop"
    fi
    # Ephemeral cap is --storage-opt size on the container rootfs — nothing to
    # unmount/delete here (the container removal frees its capped overlay layer).
    # Persistent slots: the control plane hotplug-detaches the provider volume
    # after this returns.
}

# -----------------------------------------------------------------------------
# Dispatch: the worker invokes this as either a launch or a stop.
#   dpad-launch-session launch   <slot> <volumeId> <device> <pass> [image]
#   dpad-launch-session stop      <slot>
# -----------------------------------------------------------------------------
case "${1:-}" in
    launch) shift; launch "$@" ;;
    stop)    shift; stop "$@" ;;
    *) echo "Usage: $0 {launch <slot> <volumeId|none> <device|none> <pass> [image] | stop <slot>}" >&2; exit 2 ;;
esac