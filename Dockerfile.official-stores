# Account-free official store candidate. No local test viewer or user prefixes.
ARG STORE_IMAGE=forcespt/dpadcloud-gaming@sha256:cc58f0f2fa167ba464a4c5634076d3e8720e07f890118692fa332a26ff27f4ff
ARG SERVICE_BUILDER_IMAGE=dpadplay/store-wine-builder:repro
FROM ${STORE_IMAGE} AS runtime-base
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS picker-adapter
WORKDIR /work
RUN npm install --no-audit --no-fund @electron/asar@3.2.17
COPY --from=runtime-base /opt/dpadcloud/launcher/resources/ /work/resources/
COPY scripts/dpad_patch_gog_picker.cjs /work/patch.cjs
COPY launcher/src/store_lifecycle.cjs /work/store_lifecycle.cjs
RUN ./node_modules/.bin/asar extract resources/app.asar unpacked \
    && node patch.cjs unpacked/src/main.js \
    && cp store_lifecycle.cjs unpacked/src/ \
    && node --check unpacked/src/main.js \
    && node --check unpacked/src/store_lifecycle.cjs \
    && ./node_modules/.bin/asar pack unpacked output/app.asar --unpack-dir node_modules
FROM ${SERVICE_BUILDER_IMAGE} AS store-service-builder
COPY patches/wine-epic-services.patch /tmp/epic-services.patch
COPY scripts/patch_gog_service_identity.py /tmp/patch-gog.py
COPY scripts/scope_gog_chromium_patch.py /tmp/scope-gog-chromium.py
RUN test "$(git -C /src/wine rev-parse HEAD)" = 1729f00e17e879f98f9df1f2bca86bc5d21a65df \
    && git -C /src/wine apply --check /tmp/epic-services.patch \
    && git -C /src/wine apply /tmp/epic-services.patch \
    && python3 /tmp/patch-gog.py /src/wine/programs/services/services.c /src/wine/server/token.c \
    && make -C /src/store-wine-build -j4 programs/services/x86_64-windows/services.exe server/wineserver
RUN curl -fLsS https://raw.githubusercontent.com/BCD1210/soju/54c6c10a77e72c05d048090526af000748729d88/patches/chromium-flags-append.patch -o /tmp/chromium-flags.patch \
    && echo '94ba9d7bc69fc97636a2c249cd40cbc8c62d0f835d5edbcda5e9f5d38afeec38  /tmp/chromium-flags.patch' | sha256sum -c - \
    && curl -fLsS https://raw.githubusercontent.com/BCD1210/soju/54c6c10a77e72c05d048090526af000748729d88/LICENSE -o /tmp/soju-LICENSE \
    && echo '3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986  /tmp/soju-LICENSE' | sha256sum -c - \
    && git -C /src/wine apply --check /tmp/chromium-flags.patch \
    && git -C /src/wine apply /tmp/chromium-flags.patch \
    && python3 /tmp/scope-gog-chromium.py \
    && make -C /src/store-wine-build -j4 dlls/kernelbase/x86_64-windows/kernelbase.dll \
       dlls/ucrtbase/x86_64-windows/ucrtbase.dll dlls/msvcrt/x86_64-windows/msvcrt.dll \
    && tar --exclude=.git -czf /tmp/store-wine-source.tar.gz -C /src wine ge/patches wine-staging \
       -C /tmp chromium-flags.patch scope-gog-chromium.py patch-gog.py epic-services.patch soju-LICENSE
FROM runtime-base
USER root
ARG DPAD_SOURCE_REVISION
LABEL org.opencontainers.image.revision=$DPAD_SOURCE_REVISION \
      com.dpadplay.launcher.qualification="official-stores-local-candidate"
COPY --from=store-service-builder /src/store-wine-build/programs/services/x86_64-windows/services.exe \
    /home/dpad/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/files/lib/wine/x86_64-windows/services.exe
COPY --from=store-service-builder /src/store-wine-build/server/wineserver \
    /home/dpad/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/files/bin/wineserver
COPY --from=store-service-builder /src/store-wine-build/dlls/kernelbase/x86_64-windows/kernelbase.dll \
    /src/store-wine-build/dlls/ucrtbase/x86_64-windows/ucrtbase.dll \
    /src/store-wine-build/dlls/msvcrt/x86_64-windows/msvcrt.dll \
    /home/dpad/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/files/lib/wine/x86_64-windows/
COPY --from=store-service-builder /src/wine/programs/services/services.c /src/wine/LICENSE /src/wine/COPYING.LIB \
    /src/wine/server/token.c /tmp/epic-services.patch /tmp/patch-gog.py /usr/share/doc/dpadplay/official-store-services/
COPY --from=store-service-builder /src/wine/dlls/kernelbase/process.c /src/wine/dlls/msvcrt/environ.c \
    /tmp/chromium-flags.patch /tmp/scope-gog-chromium.py /tmp/soju-LICENSE \
    /tmp/store-wine-source.tar.gz /usr/share/doc/dpadplay/official-store-services/
COPY scripts/gog-launch /opt/dpadcloud/gog-launch
COPY scripts/ea-launch /opt/dpadcloud/ea-launch
COPY scripts/battlenet-launch scripts/ubisoft-launch scripts/dpad-clone-prefix-template /opt/dpadcloud/
COPY scripts/dpad-sanitize-store-prefix /opt/dpadcloud/dpad-sanitize-store-prefix
COPY scripts/swaymsg-desktop-compat /usr/local/bin/swaymsg
COPY --from=picker-adapter /work/output/ /opt/dpadcloud/launcher/resources/
RUN sed -i 's/\r$//' /opt/dpadcloud/gog-launch \
    && chmod +x /opt/dpadcloud/gog-launch \
    && sed -i 's/\r$//' /opt/dpadcloud/ea-launch && chmod +x /opt/dpadcloud/ea-launch \
    && sed -i 's/\r$//' /opt/dpadcloud/battlenet-launch /opt/dpadcloud/ubisoft-launch /opt/dpadcloud/dpad-clone-prefix-template \
    && chmod +x /opt/dpadcloud/battlenet-launch /opt/dpadcloud/ubisoft-launch /opt/dpadcloud/dpad-clone-prefix-template \
    && sed -i 's/\r$//' /opt/dpadcloud/dpad-sanitize-store-prefix \
    && chmod +x /opt/dpadcloud/dpad-sanitize-store-prefix \
    && sed -i 's/\r$//' /usr/local/bin/swaymsg && chmod +x /usr/local/bin/swaymsg \
    && test -s /usr/local/cuda-12.5/targets/x86_64-linux/lib/libnvrtc.so.12 \
    && ln -sf libnvrtc.so.12 /usr/local/cuda-12.5/targets/x86_64-linux/lib/libnvrtc.so \
    && ldconfig \
    && chown dpad:dpad /home/dpad/.steam/debian-installation/compatibilitytools.d/GE-Proton10-34/files/lib/wine/x86_64-windows/services.exe \
    && mkdir -p /opt/dpadcloud/installers \
    && curl -fLsS --retry 3 'https://content-system.gog.com/open_link/download?path=/open/galaxy/client/setup_galaxy_2.1.9.27.exe' \
       -o /opt/dpadcloud/installers/GOGGalaxy-2.1.9.27.exe \
    && echo 'd6166eb2bc3affcea7e0160c08abdfba255a1df4aba960f5bf6b3fb77ce020aa  /opt/dpadcloud/installers/GOGGalaxy-2.1.9.27.exe' | sha256sum -c - \
    && /opt/dpadcloud/dpad-verify-windows-binary --publisher 'GOG  sp. z o.o' /opt/dpadcloud/installers/GOGGalaxy-2.1.9.27.exe \
    && bash -n /opt/dpadcloud/gog-launch /opt/dpadcloud/ea-launch /opt/dpadcloud/battlenet-launch /opt/dpadcloud/ubisoft-launch
ENV DPAD_GOG_BACKEND=official
# GPU runtime hooks can regenerate ld.so.cache with the older host library first.
# Keep the compositor's bundled Wayland 1.23 ABI ahead of that cache.
ENV LD_LIBRARY_PATH=/usr/local/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}
RUN . /opt/gstreamer/gst-env \
    && GST_REGISTRY=/tmp/dpad-build-gst-registry.bin gst-inspect-1.0 waylanddisplaysrc >/dev/null \
    && rm -f /tmp/dpad-build-gst-registry.bin
