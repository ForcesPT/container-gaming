# Local GUI harness only. Never use this unauthenticated localhost viewer in production.
ARG STORE_IMAGE=forcespt/dpadcloud-gaming@sha256:cc58f0f2fa167ba464a4c5634076d3e8720e07f890118692fa332a26ff27f4ff
FROM ${STORE_IMAGE}
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    openbox x11vnc novnc websockify xdotool x11-utils mesa-utils ffmpeg xserver-xorg-video-dummy \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/local-store-test /opt/dpadcloud/local-store-test
COPY scripts/local-store-xorg.conf /opt/dpadcloud/local-store-xorg.conf
RUN sed -i 's/\r$//' /opt/dpadcloud/local-store-test && chmod +x /opt/dpadcloud/local-store-test
ENTRYPOINT ["/opt/dpadcloud/local-store-test"]
