# Extend the qualified preinstalled official-store image; require an explicit
# base so import builds do not silently return to an older uninstalled client.
ARG STORE_IMAGE
FROM ${STORE_IMAGE}
USER root
ARG DPAD_SOURCE_REVISION
LABEL org.opencontainers.image.revision=$DPAD_SOURCE_REVISION \
      com.dpadplay.launcher.qualification="official-epic-import-candidate-not-gameplay-qualified"
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends fuse-overlayfs=1.13-1 \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/dpad_epic_installation.py scripts/dpad_epic_overlay.py scripts/dpad_faugus_prepare.py scripts/faugus-instant-entrypoint scripts/launcher-shell scripts/launcher-toggle scripts/faugus-epic-launch /opt/dpadcloud/
RUN sed -i 's/\r$//' /opt/dpadcloud/faugus-instant-entrypoint /opt/dpadcloud/launcher-shell /opt/dpadcloud/launcher-toggle /opt/dpadcloud/faugus-epic-launch \
    && chmod +x /opt/dpadcloud/faugus-instant-entrypoint /opt/dpadcloud/launcher-shell /opt/dpadcloud/launcher-toggle /opt/dpadcloud/faugus-epic-launch
ENV DPAD_FAUGUS_INSTANT_TEST=1 DPAD_FAUGUS_CLIENT_ONLY_TEST=0
ENTRYPOINT ["/opt/dpadcloud/faugus-instant-entrypoint"]
