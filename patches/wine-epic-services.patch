+/* Wine currently starts user-mode services with the caller's token. EOS
+ * distinguishes its main service from its per-user starter using LocalSystem
+ * identity. Restore that identity only for this exact vendor service. The
+ * Unix account and prefix boundary remain unchanged. */
+static BOOL is_epic_eos_system_service(const struct service_entry *service)
+{
+    const WCHAR *binary = service->config.lpBinaryPathName;
+    return !wcscmp(service->name, L"EpicOnlineServices")
+        && service->config.dwServiceType == SERVICE_WIN32_OWN_PROCESS
+        && service->config.lpDisplayName
+        && !wcscmp(service->config.lpDisplayName, L"Epic Online Services")
+        && service->config.lpServiceStartName
+        && !wcsicmp(service->config.lpServiceStartName, L"LocalSystem")
+        && binary
+        && (!wcsicmp(binary, L"C:\\Program Files (x86)\\Epic Games\\Epic Online Services\\service\\EpicOnlineServicesHost.exe")
+            || !wcsicmp(binary, L"\"C:\\Program Files (x86)\\Epic Games\\Epic Online Services\\service\\EpicOnlineServicesHost.exe\""));
+}
+
+static void *epic_token_information(HANDLE token, TOKEN_INFORMATION_CLASS type)
+{
+    DWORD size = 0;
+    void *data;
+    GetTokenInformation(token, type, NULL, 0, &size);
+    if (!size || !(data = malloc(size))) return NULL;
+    if (!GetTokenInformation(token, type, data, size, &size))
+    {
+        free(data);
+        return NULL;
+    }
+    return data;
+}
+
+static DWORD create_epic_system_token(HANDLE *result)
+{
+    HANDLE current;
+    BYTE sid[SECURITY_MAX_SID_SIZE];
+    DWORD size = sizeof(sid), err = ERROR_NOT_ENOUGH_MEMORY;
+    TOKEN_USER user = {{sid, 0}};
+    TOKEN_OWNER owner = {sid};
+    TOKEN_GROUPS *groups;
+    TOKEN_PRIVILEGES *privileges;
+    TOKEN_PRIMARY_GROUP *primary_group;
+    TOKEN_DEFAULT_DACL *dacl;
+    TOKEN_SOURCE source = {{'W','i','n','e','E','O','S',0}, {0,0}};
+    LUID luid = {0x3e7, 0};
+    LARGE_INTEGER expiration;
+    OBJECT_ATTRIBUTES attributes;
+    NTSTATUS status;
+
+    *result = NULL;
+    if (!CreateWellKnownSid(WinLocalSystemSid, NULL, sid, &size)) return GetLastError();
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &current)) return GetLastError();
+    groups = epic_token_information(current, TokenGroups);
+    privileges = epic_token_information(current, TokenPrivileges);
+    primary_group = epic_token_information(current, TokenPrimaryGroup);
+    dacl = epic_token_information(current, TokenDefaultDacl);
+    if (groups && privileges && primary_group && dacl)
+    {
+        expiration.QuadPart = MAXLONGLONG;
+        InitializeObjectAttributes(&attributes, NULL, 0, NULL, NULL);
+        status = NtCreateToken(result, TOKEN_ALL_ACCESS, &attributes, TokenPrimary,
+                               &luid, &expiration, &user, groups, privileges,
+                               &owner, primary_group, dacl, &source);
+        err = RtlNtStatusToDosError(status);
+    }
+    free(groups);
+    free(privileges);
+    free(primary_group);
+    free(dacl);
+    CloseHandle(current);
+    return err;
+}
